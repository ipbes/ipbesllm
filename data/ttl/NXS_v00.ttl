    ipbes:hasConfidenceLevel "well established" ;
    ipbes:hasDescription "They are also the water bodies most affected by human activities and climate change, with a substantial proportion having been degraded or lost over past centuries (well established) {2.3.3, 2.4.1, 2.5.1, 2.5.2}." ;
    dcterms:identifier "2.3.3, 2.4.1, 2.5.1, 2.5.2" .

<http://ontology.ipbes.net/report/subm/NXS24-A2-SM3> a ipbes:SubMessage ;
