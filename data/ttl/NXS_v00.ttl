<http://ontology.ipbes.net/report/subm/NXS24-A2-SM1> a ipbes:SubMessage ;
    ipbes:Illustration <http://ontology.ipbes.net/report/il/NXS24-FigureSPM.4> ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/NXS24-2.5.2.1> ;
    ipbes:hasConfidenceLevel "well established" ;
    ipbes:hasDescription "Water extraction for food production is responsible for approximately 80 per cent of humanity’s water demand (well established) {2.5.2.1}. The water cycle is regulated by ecosystem and geophysical processes that support biodiversity and provide nature’s contributions to people that are essential to human health and well-being (Figure SPM.4). Wetlands and inland water bodies cover just 2.6 per cent of the Earth’s terrestrial surface but play a significant role in water regulation and climate change mitigation and adaptation." ;
    dcterms:identifier "2.5.2.1" .

<http://ontology.ipbes.net/report/subm/NXS24-A2-SM2> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/NXS24-2.3.3>,
        <http://ontology.ipbes.net/report/sch/NXS24-2.4.1>,
