<http://ontology.ipbes.net/report/ref/4596166/items/2LT8LWQZ> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/NXS24ch2> ;
    ipbes:Report ipbes:NXS24 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/NXS24-2.3.1.3>,
        <http://ontology.ipbes.net/report/sch/NXS24-2.3.1.4>,
