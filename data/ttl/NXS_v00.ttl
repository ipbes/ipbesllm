    ipbes:KeyMessage <http://ontology.ipbes.net/report/key/NXS24-KM-B1>,
        <http://ontology.ipbes.net/report/key/NXS24-KM-B2> ;
    ipbes:Reference <http://ontology.ipbes.net/report/ref/4596166/items/5ZXZKFEC>,
        <http://ontology.ipbes.net/report/ref/4596166/items/77QZXDVH>,
