<http://ontology.ipbes.net/report/ref/NXS24-ch2-640> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/NXS24ch2> ;
    ipbes:Report ipbes:NXS24 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/NXS24-2.3>,
        <http://ontology.ipbes.net/report/sch/NXS24-2.3.3>,
        <http://ontology.ipbes.net/report/sch/NXS24-2.4.2> ;
