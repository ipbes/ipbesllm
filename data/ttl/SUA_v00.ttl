        <http://ontology.ipbes.net/report/ref/2344805/items/52P82NSL>,
        <http://ontology.ipbes.net/report/ref/2344805/items/6MDMCG6V>,
        <http://ontology.ipbes.net/report/ref/2344805/items/7NU4HS2T>,
        <http://ontology.ipbes.net/report/ref/2344805/items/8BJEMTLD>,
        <http://ontology.ipbes.net/report/ref/2344805/items/8TBWUWNT>,
        <http://ontology.ipbes.net/report/ref/2344805/items/AHVE8DLX>,
        <http://ontology.ipbes.net/report/ref/2344805/items/BVT5TTWA>,
        <http://ontology.ipbes.net/report/ref/2344805/items/D5I958L8>,
        <http://ontology.ipbes.net/report/ref/2344805/items/FACHXNVG>,
        <http://ontology.ipbes.net/report/ref/2344805/items/HFUAIT89>,
