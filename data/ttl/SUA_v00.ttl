        <http://ontology.ipbes.net/report/ref/2344805/items/J9NVKMEK>,
        <http://ontology.ipbes.net/report/ref/2344805/items/KJ54W6SS>,
        <http://ontology.ipbes.net/report/ref/2344805/items/M4Y29NQT>,
        <http://ontology.ipbes.net/report/ref/2344805/items/MK9VRMTB>,
        <http://ontology.ipbes.net/report/ref/2344805/items/NENU26QC>,
        <http://ontology.ipbes.net/report/ref/2344805/items/PWWWTPIC>,
        <http://ontology.ipbes.net/report/ref/2344805/items/Q8EX4J94>,
