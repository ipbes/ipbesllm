    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/SUA22-6.5> ;
    dcterms:identifier "6.5.1" ;
    skos:prefLabel "Governance characteristics that enable sustainable use" .

<http://ontology.ipbes.net/report/sch/SUA22-6.5.3> a ipbes:SubChapter ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/SUA22ch6> ;
    ipbes:KeyMessage <http://ontology.ipbes.net/report/key/SUA22-C> ;
    ipbes:Report ipbes:SUA22 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/SUA22-6.5> ;
