<http://ontology.ipbes.net/report/ref/2344805/items/WZBYGGSA> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/SUA22ch1>,
        <http://ontology.ipbes.net/report/ch/SUA22ch3>,
        <http://ontology.ipbes.net/report/ch/SUA22ch4> ;
    ipbes:Report ipbes:SUA22 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/SUA22-1.1.1>,
        <http://ontology.ipbes.net/report/sch/SUA22-3.3>,
        <http://ontology.ipbes.net/report/sch/SUA22-3.3.5.1>,
        <http://ontology.ipbes.net/report/sch/SUA22-4.2.2.4>,
        <http://ontology.ipbes.net/report/sch/SUA22-4.2.3.2.1>,
        <http://ontology.ipbes.net/report/sch/SUA22-4.3.2.3> ;
    ipbes:hasDescription "Abensperg-Traun, M. (2009). CITES, sustainable use of wild species and incentive-driven conservation in developing countries, with an emphasis on southern Africa. Biological Conservation, 142(5), 948–963. https://doi.org/10.1016/j.biocon.2008.12.034" ;
