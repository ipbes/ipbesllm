        <http://ontology.ipbes.net/report/ref/2344805/items/852I6UT2>,
        <http://ontology.ipbes.net/report/ref/2344805/items/8GT4F2B8>,
        <http://ontology.ipbes.net/report/ref/2344805/items/BF6KBVKK>,
        <http://ontology.ipbes.net/report/ref/2344805/items/EV59U7CM>,
        <http://ontology.ipbes.net/report/ref/2344805/items/F6UU8CM7>,
        <http://ontology.ipbes.net/report/ref/2344805/items/FS96B4JW>,
        <http://ontology.ipbes.net/report/ref/2344805/items/GJHAP4XN>,
        <http://ontology.ipbes.net/report/ref/2344805/items/GLUQAS5P>,
        <http://ontology.ipbes.net/report/ref/2344805/items/L2ZHEAYU>,
