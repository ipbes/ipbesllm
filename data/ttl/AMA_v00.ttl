<http://ontology.ipbes.net/report/fn/AMA18-Footnote4.8> a ipbes:Footnote ;
    ipbes:Report ipbes:AMA18 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/AMA18-4.3.2> ;
    ipbes:hasDescription "The nitrogen loss indicator was developed for the CBD and represents the potential nitrogen pollution from all sources within a country or region as a result of the production and consumption of food and the use of energy (WWF, 2014)." ;
    dcterms:identifier "Footnote4.8" .

<http://ontology.ipbes.net/report/fn/AMA18-Footnote4.9> a ipbes:Footnote ;
    ipbes:Report ipbes:AMA18 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/AMA18-4.3.2> ;
    ipbes:hasDescription "The export diversification index is calculated by measuring the absolute deviation of the export structure of a country from world structure. This index takes values between 0 and 1. A value closer to 1 indicates greater divergence from the world pattern (UNCTAD, 2016)." ;
    dcterms:identifier "Footnote4.9" .

