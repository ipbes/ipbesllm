    ipbes:Reference <http://ontology.ipbes.net/report/ref/2333011/items/3UXJ54FH>,
        <http://ontology.ipbes.net/report/ref/2333011/items/5YNQ9SMB>,
        <http://ontology.ipbes.net/report/ref/2333011/items/C6FNLJ73>,
        <http://ontology.ipbes.net/report/ref/2333011/items/CYAP2GFJ>,
