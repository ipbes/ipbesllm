        <http://ontology.ipbes.net/report/ref/2333075/items/C2H6HAG9>,
        <http://ontology.ipbes.net/report/ref/2333075/items/D6CCILDZ>,
        <http://ontology.ipbes.net/report/ref/2333075/items/DRH2IVPE>,
        <http://ontology.ipbes.net/report/ref/2333075/items/GD3ZVRMK>,
        <http://ontology.ipbes.net/report/ref/2333075/items/JES9NVKZ>,
        <http://ontology.ipbes.net/report/ref/2333075/items/KEFZBEJS>,
        <http://ontology.ipbes.net/report/ref/2333075/items/NNU68K2A>,
        <http://ontology.ipbes.net/report/ref/2333075/items/QHJV399P>,
        <http://ontology.ipbes.net/report/ref/2333075/items/RC7T286A>,
        <http://ontology.ipbes.net/report/ref/2333075/items/UDUZ6XFP>,
