        <http://ontology.ipbes.net/report/ref/2333075/items/8ZC9KHLW>,
        <http://ontology.ipbes.net/report/ref/2333075/items/98Q5V63Z>,
        <http://ontology.ipbes.net/report/ref/2333075/items/EBECK4R6>,
        <http://ontology.ipbes.net/report/ref/2333075/items/FY2N2XQG>,
        <http://ontology.ipbes.net/report/ref/2333075/items/HAE46LM2>,
