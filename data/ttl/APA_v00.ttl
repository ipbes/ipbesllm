    ipbes:Reference <http://ontology.ipbes.net/report/ref/2333075/items/4CFKDTYD>,
        <http://ontology.ipbes.net/report/ref/2333075/items/62D8XMRR>,
        <http://ontology.ipbes.net/report/ref/2333075/items/67PBICPI>,
        <http://ontology.ipbes.net/report/ref/2333075/items/DYEVDI9K>,
        <http://ontology.ipbes.net/report/ref/2333075/items/E2UDA729>,
