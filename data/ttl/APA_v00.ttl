    ipbes:Reference <http://ontology.ipbes.net/report/ref/2333075/items/47LU4D7L>,
        <http://ontology.ipbes.net/report/ref/2333075/items/5ZSRAAQM>,
        <http://ontology.ipbes.net/report/ref/2333075/items/A52KB34V>,
        <http://ontology.ipbes.net/report/ref/2333075/items/ABYEI5XP>,
