        <http://ontology.ipbes.net/report/key/APA18-21>,
        <http://ontology.ipbes.net/report/key/APA18-22>,
        <http://ontology.ipbes.net/report/key/APA18-23> ;
    ipbes:Reference <http://ontology.ipbes.net/report/ref/2333075/items/67VPWIMA>,
        <http://ontology.ipbes.net/report/ref/2333075/items/6TTV6UEV>,
        <http://ontology.ipbes.net/report/ref/2333075/items/9GJCIHCL>,
        <http://ontology.ipbes.net/report/ref/2333075/items/9YGYQVWP>,
        <http://ontology.ipbes.net/report/ref/2333075/items/AVT4CGNE>,
        <http://ontology.ipbes.net/report/ref/2333075/items/CR6VHXN7>,
        <http://ontology.ipbes.net/report/ref/2333075/items/FV9ULU79>,
        <http://ontology.ipbes.net/report/ref/2333075/items/HA4RMGAH>,
        <http://ontology.ipbes.net/report/ref/2333075/items/IPU8QCHD>,
        <http://ontology.ipbes.net/report/ref/2333075/items/KU6ZIY8M>,
        <http://ontology.ipbes.net/report/ref/2333075/items/NPZEBQ5Z>,
        <http://ontology.ipbes.net/report/ref/2333075/items/NSQPK48Y>,
        <http://ontology.ipbes.net/report/ref/2333075/items/NUWYZE4H>,
        <http://ontology.ipbes.net/report/ref/2333075/items/WDCDVJZM>,
        <http://ontology.ipbes.net/report/ref/2333075/items/WUIMNGPZ>,
        <http://ontology.ipbes.net/report/ref/2333075/items/X2G3DVYN>,
