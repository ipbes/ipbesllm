        <http://ontology.ipbes.net/report/key/GA119-A6>,
        <http://ontology.ipbes.net/report/key/GA119-A7>,
        <http://ontology.ipbes.net/report/key/GA119-A8> ;
    ipbes:Reference <http://ontology.ipbes.net/report/ref/2333077/items/7M84NXBP>,
        <http://ontology.ipbes.net/report/ref/2333077/items/8PW8AV5V>,
        <http://ontology.ipbes.net/report/ref/2333077/items/CG463P3P>,
        <http://ontology.ipbes.net/report/ref/2333077/items/E6ADN2J6>,
        <http://ontology.ipbes.net/report/ref/2333077/items/EQFQG7DM>,
        <http://ontology.ipbes.net/report/ref/2333077/items/FR9E3PVM>,
        <http://ontology.ipbes.net/report/ref/2333077/items/GKN8JWEX>,
        <http://ontology.ipbes.net/report/ref/2333077/items/HGWRDVDW>,
        <http://ontology.ipbes.net/report/ref/2333077/items/PZMGF2CG>,
        <http://ontology.ipbes.net/report/ref/2333077/items/S2QWHDVI>,
        <http://ontology.ipbes.net/report/ref/2333077/items/TEW55N7N>,
        <http://ontology.ipbes.net/report/ref/2333077/items/VAARK6FX>,
        <http://ontology.ipbes.net/report/ref/2333077/items/VRGJSA6B>,
