        <http://ontology.ipbes.net/report/ref/2333077/items/6V9DGJIC>,
        <http://ontology.ipbes.net/report/ref/2333077/items/7LLWR9CL>,
        <http://ontology.ipbes.net/report/ref/2333077/items/7S9U38WL>,
        <http://ontology.ipbes.net/report/ref/2333077/items/97AIS4YR>,
        <http://ontology.ipbes.net/report/ref/2333077/items/APDA4EU8>,
        <http://ontology.ipbes.net/report/ref/2333077/items/CW8HZ698>,
        <http://ontology.ipbes.net/report/ref/2333077/items/DMIU5RM5>,
        <http://ontology.ipbes.net/report/ref/2333077/items/DXTUMC6R>,
        <http://ontology.ipbes.net/report/ref/2333077/items/FJK48RZC>,
        <http://ontology.ipbes.net/report/ref/2333077/items/FSHF73H6>,
        <http://ontology.ipbes.net/report/ref/2333077/items/FYM6Y298>,
        <http://ontology.ipbes.net/report/ref/2333077/items/HDWK6NZB>,
        <http://ontology.ipbes.net/report/ref/2333077/items/HPNJM6FA>,
        <http://ontology.ipbes.net/report/ref/2333077/items/I8TU5FFA>,
        <http://ontology.ipbes.net/report/ref/2333077/items/MTY48EKT>,
        <http://ontology.ipbes.net/report/ref/2333077/items/R6WU3X4S>,
