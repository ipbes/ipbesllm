        <http://ontology.ipbes.net/report/key/GA119-D3>,
        <http://ontology.ipbes.net/report/key/GA119-D4>,
        <http://ontology.ipbes.net/report/key/GA119-D5>,
        <http://ontology.ipbes.net/report/key/GA119-D6>,
        <http://ontology.ipbes.net/report/key/GA119-D7>,
        <http://ontology.ipbes.net/report/key/GA119-D8>,
        <http://ontology.ipbes.net/report/key/GA119-D9> ;
    ipbes:Report ipbes:GA119 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/GA119-6.3.3> ;
    ipbes:hasDescription "National governments play a major role in determining the balance of coastal protection and resource use, and global codes and conventions can help promote national action, e.g., SDG 14 (life below water). Governments face the challenges of harmonising and coordinating responsible agencies and interests, setting national policies and priorities, coordinating and integrating planning, resourcing, implementing, monitoring and reporting. Locally led initiatives can also feed up into national policies (see 6.3.3.3.3)." ;
    dcterms:identifier "6.3.3.3" ;
    skos:prefLabel "Coastal Waters" .

