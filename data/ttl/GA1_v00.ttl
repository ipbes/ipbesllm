    dcterms:identifier "2.2.5.3" ;
    skos:prefLabel "Status and trends of nature in land and sea managed and/or held by Indigenous Peoples and Local Communities" .

<http://ontology.ipbes.net/report/sch/GA119-2.2.6> a ipbes:SubChapter ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/GA119ch2> ;
