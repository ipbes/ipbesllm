        <http://ontology.ipbes.net/report/ref/2333077/items/ADSC3WX5>,
        <http://ontology.ipbes.net/report/ref/2333077/items/AHNT4ZQT>,
        <http://ontology.ipbes.net/report/ref/2333077/items/AN5D6WYG>,
        <http://ontology.ipbes.net/report/ref/2333077/items/BJ42J9SB>,
        <http://ontology.ipbes.net/report/ref/2333077/items/C9MSITBG>,
        <http://ontology.ipbes.net/report/ref/2333077/items/E2987VXN>,
        <http://ontology.ipbes.net/report/ref/2333077/items/FUYBMST9>,
        <http://ontology.ipbes.net/report/ref/2333077/items/GVKJDHRY>,
