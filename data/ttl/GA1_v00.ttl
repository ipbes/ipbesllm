<http://ontology.ipbes.net/report/ref/2333077/items/2EMKPF78> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/GA119ch4> ;
    ipbes:Report ipbes:GA119 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/GA119-4.6.1>,
        <http://ontology.ipbes.net/report/sch/GA119-4.7.1>,
