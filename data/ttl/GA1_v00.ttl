        <http://ontology.ipbes.net/report/ref/2333077/items/KCNGW2PP>,
        <http://ontology.ipbes.net/report/ref/2333077/items/KIHELI5N>,
        <http://ontology.ipbes.net/report/ref/2333077/items/L7RSYI95>,
        <http://ontology.ipbes.net/report/ref/2333077/items/PNGC39KR>,
        <http://ontology.ipbes.net/report/ref/2333077/items/QNAS8EVT>,
        <http://ontology.ipbes.net/report/ref/2333077/items/TCJXASAU>,
