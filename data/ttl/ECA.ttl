<http://ontology.ipbes.net/report/ref/2345951/items/GPZFML5D> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/ECA18ch1>,
        <http://ontology.ipbes.net/report/ch/ECA18ch4>,
        <http://ontology.ipbes.net/report/ch/ECA18ch5>,
        <http://ontology.ipbes.net/report/ch/ECA18ch6> ;
    ipbes:Report ipbes:ECA18 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/ECA18-1.1>,
        <http://ontology.ipbes.net/report/sch/ECA18-1.1.4>,
        <http://ontology.ipbes.net/report/sch/ECA18-1.1.5>,
