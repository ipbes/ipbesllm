<http://ontology.ipbes.net/report/sch/ECA18-4.5.2.2> a ipbes:SubChapter ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/ECA18ch4> ;
    ipbes:Reference <http://ontology.ipbes.net/report/ref/ECA18-ch4-2508>,
        <http://ontology.ipbes.net/report/ref/ECA18-ch4-2803> ;
    ipbes:Report ipbes:ECA18 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/ECA18-4.5.2> ;
    ipbes:hasDescription "Changes in agriculture are driven by multiple interconnected institutional, economic, cultural and technological drivers (Figure 4.11)." ;
    dcterms:identifier "4.5.2.2" ;
    skos:prefLabel "Indirect drivers of trends in agricultural land use" .

<http://ontology.ipbes.net/report/sch/ECA18-4.5.4> a ipbes:SubChapter ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/ECA18ch4> ;
