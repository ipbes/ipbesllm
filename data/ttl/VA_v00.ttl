        <http://ontology.ipbes.net/report/ref/2345372/items/LA2RIZLU>,
        <http://ontology.ipbes.net/report/ref/2345372/items/LQX6C4BS>,
        <http://ontology.ipbes.net/report/ref/2345372/items/LW9EXIWK>,
        <http://ontology.ipbes.net/report/ref/2345372/items/MZ3Q7FFX>,
        <http://ontology.ipbes.net/report/ref/2345372/items/SFCY2I4Y>,
