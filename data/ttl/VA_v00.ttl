        <http://ontology.ipbes.net/report/ch/VA22ch6> ;
    ipbes:Report ipbes:VA22 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/VA22-2.4.1.3>,
        <http://ontology.ipbes.net/report/sch/VA22-5.3.2.1>,
