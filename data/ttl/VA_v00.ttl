        <http://ontology.ipbes.net/report/ref/2345372/items/IKPE78WA>,
        <http://ontology.ipbes.net/report/ref/2345372/items/JTTMPCQT>,
        <http://ontology.ipbes.net/report/ref/2345372/items/KQP59R8S>,
        <http://ontology.ipbes.net/report/ref/2345372/items/KTMLKD5D>,
        <http://ontology.ipbes.net/report/ref/2345372/items/MG9B8SIJ>,
        <http://ontology.ipbes.net/report/ref/2345372/items/MVFR3974>,
