        <http://ontology.ipbes.net/report/ref/2345372/items/EI2ZIGC2>,
        <http://ontology.ipbes.net/report/ref/2345372/items/FNDFKIQ4>,
        <http://ontology.ipbes.net/report/ref/2345372/items/HV9SCU54>,
        <http://ontology.ipbes.net/report/ref/2345372/items/IU2ZYZDS>,
        <http://ontology.ipbes.net/report/ref/2345372/items/J8234IX9>,
        <http://ontology.ipbes.net/report/ref/2345372/items/KKFV6ZI5>,
        <http://ontology.ipbes.net/report/ref/2345372/items/LMLRAEUT>,
        <http://ontology.ipbes.net/report/ref/2345372/items/MCZL4MFG>,
        <http://ontology.ipbes.net/report/ref/2345372/items/N2CMWGW4>,
