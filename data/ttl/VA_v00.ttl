<http://ontology.ipbes.net/report/ref/2345372/items/MG3V59JJ> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/VA22ch2>,
        <http://ontology.ipbes.net/report/ch/VA22ch5> ;
    ipbes:Report ipbes:VA22 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/VA22-2.2.1>,
        <http://ontology.ipbes.net/report/sch/VA22-2.2.3.2>,
        <http://ontology.ipbes.net/report/sch/VA22-2.3.2.2>,
        <http://ontology.ipbes.net/report/sch/VA22-5.3>,
        <http://ontology.ipbes.net/report/sch/VA22-5.3.2> ;
    ipbes:hasDescription "Kenter, J. O., Raymond, C. M., Van Riper, C. J., Azzopardi, E., Brear, M. R., Calcagni, F., Christie, I., Christie, M., Fordham, A., Gould, R. K., Ives, C. D., Hejnowicz, A. P., Gunton, R., Horcea-Milcu, A. I., Kendal, D., Kronenberg, J., Massenberg, J. R., O’connor, S., Ravenscroft, N., … Thankappan, S. (2019). Loving the mess: Navigating diversity and conflict in social values for sustainability. Sustainability Science, 14(5), 1439-1461. Scopus. https://doi.org/10.1007/s11625-019-00726-4" ;
