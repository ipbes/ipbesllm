        <http://ontology.ipbes.net/report/ref/2345372/items/AB6A9539>,
        <http://ontology.ipbes.net/report/ref/2345372/items/BJEC8TPI>,
        <http://ontology.ipbes.net/report/ref/2345372/items/CSM8UFHD>,
        <http://ontology.ipbes.net/report/ref/2345372/items/DFDPZC62>,
        <http://ontology.ipbes.net/report/ref/2345372/items/FIQAUP5H>,
        <http://ontology.ipbes.net/report/ref/2345372/items/G9HJBM8J>,
        <http://ontology.ipbes.net/report/ref/2345372/items/HBBKP5J5>,
        <http://ontology.ipbes.net/report/ref/2345372/items/JE8UTZQG>,
        <http://ontology.ipbes.net/report/ref/2345372/items/KMRXTXX6>,
        <http://ontology.ipbes.net/report/ref/2345372/items/P7XRASRB>,
        <http://ontology.ipbes.net/report/ref/2345372/items/PEYIPQFQ>,
        <http://ontology.ipbes.net/report/ref/2345372/items/SBANWJJA>,
        <http://ontology.ipbes.net/report/ref/2345372/items/SS2NS3JN>,
        <http://ontology.ipbes.net/report/ref/2345372/items/TVQMKL2F>,
        <http://ontology.ipbes.net/report/ref/2345372/items/UVMRE3H3>,
