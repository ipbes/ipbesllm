<http://ontology.ipbes.net/report/fn/VA22-Footnote6.10> a ipbes:Footnote ;
    ipbes:Report ipbes:VA22 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/VA22-6.3.2.2> ;
    ipbes:hasDescription "The t-learning project produced nine national case studies, including Sweden, Malawi, Zimbabwe, Netherlands, India, Vietnam, Ethiopia, Colombia, and South Africa. See https://transgressivelearning.org/." ;
    dcterms:identifier "Footnote6.10" .

