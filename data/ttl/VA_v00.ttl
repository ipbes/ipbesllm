<http://ontology.ipbes.net/report/ref/2345372/items/T23WTMMD> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/VA22ch1>,
        <http://ontology.ipbes.net/report/ch/VA22ch2> ;
    ipbes:Report ipbes:VA22 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/VA22-1.1.1>,
        <http://ontology.ipbes.net/report/sch/VA22-1.1.2>,
        <http://ontology.ipbes.net/report/sch/VA22-1.2.1>,
