        <http://ontology.ipbes.net/report/ref/2345372/items/TSIB2IUY>,
        <http://ontology.ipbes.net/report/ref/2345372/items/VGUZ2TVL>,
        <http://ontology.ipbes.net/report/ref/2345372/items/WBD2VXST>,
        <http://ontology.ipbes.net/report/ref/2345372/items/WQSKSERT>,
        <http://ontology.ipbes.net/report/ref/2345372/items/X5ND5N4Z>,
        <http://ontology.ipbes.net/report/ref/2345372/items/XH4DVJE5>,
