<http://ontology.ipbes.net/report/ref/2345372/items/7IE38B68> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/VA22ch4>,
        <http://ontology.ipbes.net/report/ch/VA22ch6> ;
    ipbes:Report ipbes:VA22 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/VA22-4.2.2>,
        <http://ontology.ipbes.net/report/sch/VA22-6.1.1>,
