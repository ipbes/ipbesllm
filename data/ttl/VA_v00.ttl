<http://ontology.ipbes.net/report/sch/VA22-4.3.5.3> a ipbes:SubChapter ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/VA22ch4> ;
    ipbes:Reference <http://ontology.ipbes.net/report/ref/2345372/items/3TSEHWNW>,
        <http://ontology.ipbes.net/report/ref/2345372/items/43CI245Z>,
        <http://ontology.ipbes.net/report/ref/2345372/items/6D3TJP23>,
        <http://ontology.ipbes.net/report/ref/2345372/items/6GKVD95W>,
        <http://ontology.ipbes.net/report/ref/2345372/items/6ULULY5Z>,
        <http://ontology.ipbes.net/report/ref/2345372/items/7AI6S6IE>,
        <http://ontology.ipbes.net/report/ref/2345372/items/7W327YM9>,
        <http://ontology.ipbes.net/report/ref/2345372/items/84M3JDC7>,
