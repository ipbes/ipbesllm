        <http://ontology.ipbes.net/report/ref/2345372/items/ETGWVAG6>,
        <http://ontology.ipbes.net/report/ref/2345372/items/FGA4X49U>,
        <http://ontology.ipbes.net/report/ref/2345372/items/IKNX8GTA>,
        <http://ontology.ipbes.net/report/ref/2345372/items/KAMRPBDW>,
        <http://ontology.ipbes.net/report/ref/2345372/items/KHGYNHNP>,
        <http://ontology.ipbes.net/report/ref/2345372/items/L5WE6FDL>,
        <http://ontology.ipbes.net/report/ref/2345372/items/LW6YJUEG>,
        <http://ontology.ipbes.net/report/ref/2345372/items/M3E6UPW6>,
        <http://ontology.ipbes.net/report/ref/2345372/items/RF4PJWD5>,
