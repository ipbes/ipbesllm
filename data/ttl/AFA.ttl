<http://ontology.ipbes.net/report/ref/AFA18-ch3-917> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/AFA18ch3> ;
    ipbes:Report ipbes:AFA18 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/AFA18-3.4.2.1.2>,
        <http://ontology.ipbes.net/report/sch/AFA18-3.4.2.1.3>,
        <http://ontology.ipbes.net/report/sch/AFA18-3.4.2.1.4>,
