    ipbes:Reference <http://ontology.ipbes.net/report/ref/2333070/items/2X5NVIUV>,
        <http://ontology.ipbes.net/report/ref/2333070/items/3PYNMLFD>,
        <http://ontology.ipbes.net/report/ref/2333070/items/43CUH4AJ>,
        <http://ontology.ipbes.net/report/ref/2333070/items/4ZTDL9I9>,
        <http://ontology.ipbes.net/report/ref/2333070/items/69DLYZDK>,
        <http://ontology.ipbes.net/report/ref/2333070/items/BUPZ37PN>,
        <http://ontology.ipbes.net/report/ref/2333070/items/BUXMHUJQ>,
        <http://ontology.ipbes.net/report/ref/2333070/items/CXHEERD7>,
        <http://ontology.ipbes.net/report/ref/2333070/items/DQGWIN6L>,
