        <http://ontology.ipbes.net/report/ref/2333070/items/7FTJK7DM>,
        <http://ontology.ipbes.net/report/ref/2333070/items/7IKXSCSI>,
        <http://ontology.ipbes.net/report/ref/2333070/items/HTTEXNJU>,
        <http://ontology.ipbes.net/report/ref/2333070/items/JLFQEM92>,
        <http://ontology.ipbes.net/report/ref/2333070/items/M9K446UM>,
        <http://ontology.ipbes.net/report/ref/2333070/items/MA7FCI9I>,
        <http://ontology.ipbes.net/report/ref/2333070/items/QVK4GUEH>,
