    ipbes:Reference <http://ontology.ipbes.net/report/ref/2333088/items/4FSYUKUX>,
        <http://ontology.ipbes.net/report/ref/2333088/items/83M48SFK>,
        <http://ontology.ipbes.net/report/ref/2333088/items/CBUMDQN6>,
        <http://ontology.ipbes.net/report/ref/2333088/items/EGQXLPE3>,
        <http://ontology.ipbes.net/report/ref/2333088/items/F67VYB6F>,
        <http://ontology.ipbes.net/report/ref/2333088/items/FUL2L98W>,
        <http://ontology.ipbes.net/report/ref/2333088/items/GE4EETPG>,
        <http://ontology.ipbes.net/report/ref/2333088/items/I3WK968T>,
        <http://ontology.ipbes.net/report/ref/2333088/items/KYT9RC8W>,
        <http://ontology.ipbes.net/report/ref/2333088/items/NKQR4Y3E>,
        <http://ontology.ipbes.net/report/ref/2333088/items/RUPSMJWI>,
        <http://ontology.ipbes.net/report/ref/2333088/items/SC4K486K>,
        <http://ontology.ipbes.net/report/ref/2333088/items/X3VP9TDV>,
        <http://ontology.ipbes.net/report/ref/2333088/items/XANDE54D>,
