<http://ontology.ipbes.net/report/sch/PPA16-2.4.1.2.3> a ipbes:SubChapter ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/PPA16ch2> ;
    ipbes:Reference <http://ontology.ipbes.net/report/ref/2333088/items/4JGGL8I9>,
        <http://ontology.ipbes.net/report/ref/2333088/items/6Y872BW7>,
        <http://ontology.ipbes.net/report/ref/2333088/items/X75M7XKH>,
        <http://ontology.ipbes.net/report/ref/2333088/items/XV2JUICD> ;
    ipbes:Report ipbes:PPA16 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/PPA16-2.4.1.2> ;
    ipbes:hasDescription "Parasites in bumble bees are numerous and widespread (Schmid-Hempel, 2001) and their effect can be quite devastating (Rutrecht and Brown, 2009; Otti and Schmid-Hempel, 2007). Nosema bombi (Microsporidia: Nosematidae) has been suspected to be the driving factor for declines of certain North American bumble bee species as well as in China (Li et al., 2011)." ;
    dcterms:identifier "2.4.1.2.3" ;
    skos:prefLabel "Fungi of bumble bees" .

