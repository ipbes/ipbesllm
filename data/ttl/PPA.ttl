        <http://ontology.ipbes.net/report/key/PPA16-9> ;
    ipbes:Reference <http://ontology.ipbes.net/report/ref/2333088/items/4JJURDBQ>,
        <http://ontology.ipbes.net/report/ref/2333088/items/9DWD6JAV>,
        <http://ontology.ipbes.net/report/ref/2333088/items/A5LNPWH8>,
        <http://ontology.ipbes.net/report/ref/2333088/items/IB4TY9CM>,
        <http://ontology.ipbes.net/report/ref/2333088/items/J47AWU8X>,
        <http://ontology.ipbes.net/report/ref/2333088/items/MPJWXSVZ>,
        <http://ontology.ipbes.net/report/ref/2333088/items/QMJFE3FU>,
        <http://ontology.ipbes.net/report/ref/2333088/items/R88GL9TX>,
        <http://ontology.ipbes.net/report/ref/2333088/items/RDX8A2MP>,
        <http://ontology.ipbes.net/report/ref/2333088/items/RWZSRKKR>,
