        <http://ontology.ipbes.net/report/ref/2333088/items/SH7UFNCX>,
        <http://ontology.ipbes.net/report/ref/2333088/items/SUTYUCNK>,
        <http://ontology.ipbes.net/report/ref/2333088/items/TM6ZQUXQ>,
        <http://ontology.ipbes.net/report/ref/2333088/items/UAEIXKN5>,
        <http://ontology.ipbes.net/report/ref/2333088/items/VQKUL8YM>,
        <http://ontology.ipbes.net/report/ref/2333088/items/WHE3QH47>,
        <http://ontology.ipbes.net/report/ref/2333088/items/WX99W2UD>,
        <http://ontology.ipbes.net/report/ref/2333088/items/YB5CUJSM>,
