        <http://ontology.ipbes.net/report/ref/2333088/items/8NKWRRJU>,
        <http://ontology.ipbes.net/report/ref/2333088/items/A2HSEX2D>,
        <http://ontology.ipbes.net/report/ref/2333088/items/BGXFPB9G>,
        <http://ontology.ipbes.net/report/ref/2333088/items/BTCUZLGM>,
        <http://ontology.ipbes.net/report/ref/2333088/items/C56LAVUW>,
        <http://ontology.ipbes.net/report/ref/2333088/items/DXYUWLY8>,
        <http://ontology.ipbes.net/report/ref/2333088/items/F8DNLBPK>,
