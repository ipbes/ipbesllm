<http://ontology.ipbes.net/report/ref/PPA16-ch6-3198> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/PPA16ch6> ;
    ipbes:Report ipbes:PPA16 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/PPA16-6.4.3.2.1>,
        <http://ontology.ipbes.net/report/sch/PPA16-6.4.6.3.2> ;
