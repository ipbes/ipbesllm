<http://ontology.ipbes.net/report/ref/2333088/items/93IHTDNX> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/PPA16ch1>,
        <http://ontology.ipbes.net/report/ch/PPA16ch2>,
        <http://ontology.ipbes.net/report/ch/PPA16ch4>,
        <http://ontology.ipbes.net/report/ch/PPA16ch6> ;
    ipbes:Report ipbes:PPA16 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/PPA16-1.1>,
        <http://ontology.ipbes.net/report/sch/PPA16-2.4.2.1>,
