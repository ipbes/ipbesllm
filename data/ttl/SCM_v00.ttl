<http://ontology.ipbes.net/report/ref/2333079/items/TPTWXBLC> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/SCM16ch1>,
        <http://ontology.ipbes.net/report/ch/SCM16ch2>,
        <http://ontology.ipbes.net/report/ch/SCM16ch8> ;
    ipbes:Report ipbes:SCM16 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/SCM16-1.1.2>,
