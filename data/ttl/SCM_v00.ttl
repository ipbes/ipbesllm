<http://ontology.ipbes.net/report/ref/2333079/items/VPTV84FF> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/SCM16ch4>,
        <http://ontology.ipbes.net/report/ch/SCM16ch8> ;
    ipbes:Report ipbes:SCM16 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/SCM16-4.2>,
        <http://ontology.ipbes.net/report/sch/SCM16-4.2.1>,
        <http://ontology.ipbes.net/report/sch/SCM16-4.2.3.4>,
        <http://ontology.ipbes.net/report/sch/SCM16-4.3.1.1>,
        <http://ontology.ipbes.net/report/sch/SCM16-4.3.1.5>,
        <http://ontology.ipbes.net/report/sch/SCM16-8.3.1.1> ;
    ipbes:hasDescription "Thuiller, W., Münkemüller, T., Lavergne, S., Mouillot, D., Mouquet, N., Schiffers, K. and Gravel, D., 2013: A road map for integrating eco-evolutionary processes into biodiversity models. Ecology Letters, 16: 94-105." ;
