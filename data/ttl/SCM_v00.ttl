        <http://ontology.ipbes.net/report/key/SCM16-3> ;
    ipbes:Reference <http://ontology.ipbes.net/report/ref/2333079/items/39JZXCTT>,
        <http://ontology.ipbes.net/report/ref/2333079/items/DH7KJQQ9>,
        <http://ontology.ipbes.net/report/ref/2333079/items/E32SX2QT>,
        <http://ontology.ipbes.net/report/ref/2333079/items/HSUWQ7UY>,
        <http://ontology.ipbes.net/report/ref/2333079/items/L68IX8VE>,
        <http://ontology.ipbes.net/report/ref/2333079/items/LZUHZQJS>,
        <http://ontology.ipbes.net/report/ref/2333079/items/P6UWMCIE>,
        <http://ontology.ipbes.net/report/ref/2333079/items/PDGFRXSQ>,
        <http://ontology.ipbes.net/report/ref/2333079/items/PQXWL2Y4>,
        <http://ontology.ipbes.net/report/ref/2333079/items/QMXS6FKM>,
        <http://ontology.ipbes.net/report/ref/2333079/items/RYACGXHU>,
        <http://ontology.ipbes.net/report/ref/2333079/items/T2C4UV5G>,
        <http://ontology.ipbes.net/report/ref/2333079/items/TPTWXBLC>,
        <http://ontology.ipbes.net/report/ref/2333079/items/UGJ3B9KC>,
