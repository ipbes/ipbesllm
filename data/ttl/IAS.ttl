    ipbes:Reference <http://ontology.ipbes.net/report/ref/2352922/items/4PE3A27U>,
        <http://ontology.ipbes.net/report/ref/2352922/items/4TC7E3X7>,
        <http://ontology.ipbes.net/report/ref/2352922/items/67TNN4I6>,
        <http://ontology.ipbes.net/report/ref/2352922/items/6L9R2U3E>,
