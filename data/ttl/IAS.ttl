    ipbes:Reference <http://ontology.ipbes.net/report/ref/2352922/items/3G2W667Z>,
        <http://ontology.ipbes.net/report/ref/2352922/items/4GAJABTB>,
        <http://ontology.ipbes.net/report/ref/2352922/items/56HYJH5I>,
        <http://ontology.ipbes.net/report/ref/2352922/items/96VGCTZ4>,
        <http://ontology.ipbes.net/report/ref/2352922/items/AC5MTZNR>,
        <http://ontology.ipbes.net/report/ref/2352922/items/AHXKM7DU>,
        <http://ontology.ipbes.net/report/ref/2352922/items/ATDXZ3G8>,
        <http://ontology.ipbes.net/report/ref/2352922/items/BNSPKEQ6>,
        <http://ontology.ipbes.net/report/ref/2352922/items/F2FTNAVD>,
        <http://ontology.ipbes.net/report/ref/2352922/items/FJC63ITF>,
        <http://ontology.ipbes.net/report/ref/2352922/items/FSPN7EN5>,
        <http://ontology.ipbes.net/report/ref/2352922/items/FULR9TXL>,
        <http://ontology.ipbes.net/report/ref/2352922/items/I3PAYFDV>,
        <http://ontology.ipbes.net/report/ref/2352922/items/LLX26VZW>,
        <http://ontology.ipbes.net/report/ref/2352922/items/N4C9D75M>,
        <http://ontology.ipbes.net/report/ref/2352922/items/NJYZEFXF>,
        <http://ontology.ipbes.net/report/ref/2352922/items/SE2ZEFD5>,
        <http://ontology.ipbes.net/report/ref/2352922/items/V83CIDSQ>,
        <http://ontology.ipbes.net/report/ref/2352922/items/WQTFEG52>,
