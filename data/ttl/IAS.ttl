        <http://ontology.ipbes.net/report/ref/2352922/items/EHH2Y2EQ>,
        <http://ontology.ipbes.net/report/ref/2352922/items/HIHZVCQ7>,
        <http://ontology.ipbes.net/report/ref/2352922/items/IF4Q4XDC>,
        <http://ontology.ipbes.net/report/ref/2352922/items/JQ7JQKMV>,
        <http://ontology.ipbes.net/report/ref/2352922/items/KJ38DQQK>,
        <http://ontology.ipbes.net/report/ref/2352922/items/PA2RWMQL>,
        <http://ontology.ipbes.net/report/ref/2352922/items/QFDFFAZU>,
        <http://ontology.ipbes.net/report/ref/2352922/items/QNV36SHA>,
        <http://ontology.ipbes.net/report/ref/2352922/items/TKKQDSX6>,
        <http://ontology.ipbes.net/report/ref/2352922/items/VKZHJ7KR>,
        <http://ontology.ipbes.net/report/ref/2352922/items/WAB3RDRW>,
        <http://ontology.ipbes.net/report/ref/2352922/items/WXJ7MDE7>,
