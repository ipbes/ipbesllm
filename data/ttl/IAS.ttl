    ipbes:Report ipbes:IAS23 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.3.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.3.1.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.3.1.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-5.3.3> ;
    ipbes:hasDescription "Downey, P. O., & Sheppard, A. W. (2006). Site- versus species-based approaches to weed management in Australia. In C. Preston, J. Watts H., & N. D. Crossman (Eds.), The Proceedings of the 15th Australian Weeds Conference: Managing Weeds in a Changing Climate (pp. 264– 267). Weed Management Society of South" ;
