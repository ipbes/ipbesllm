<http://ontology.ipbes.net/report/il/IAS23-Figure5.27> a ipbes:Figure,
        ipbes:Illustration ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-5.6> ;
    ipbes:hasDescription "Adapted from Walther et al., (2009), https://doi.org/10.1016/j.tree.2009.06.008, under copyright 2009 Elsevier Ltd. See also Chapter 3, section 3.4.2." ;
