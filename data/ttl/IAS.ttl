    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-6.4.3> ;
    ipbes:hasConfidenceLevel "established but incomplete" ;
    ipbes:hasDescription "Such co-governance structures improve quality of life for Indigenous Peoples and local communities (established but incomplete) {6.4.3}." ;
