<http://ontology.ipbes.net/report/fn/IAS23-Footnote5.12> a ipbes:Footnote ;
    ipbes:Report ipbes:IAS23 ;
    ipbes:hasDescription "Where there is a detectable signal e.g., in the attacked host plant for pathogens and invertebrate herbivores." ;
    dcterms:identifier "Footnote5.12" .

<http://ontology.ipbes.net/report/fn/IAS23-Footnote5.13> a ipbes:Footnote ;
    ipbes:Report ipbes:IAS23 ;
    ipbes:hasDescription "Only where species are taxonomically defined, which is not always the case." ;
    dcterms:identifier "Footnote5.13" .

<http://ontology.ipbes.net/report/fn/IAS23-Footnote5.14> a ipbes:Footnote ;
    ipbes:Report ipbes:IAS23 ;
    ipbes:hasDescription "Where noise making." ;
    dcterms:identifier "Footnote5.14" .

<http://ontology.ipbes.net/report/fn/IAS23-Footnote5.15> a ipbes:Footnote ;
    ipbes:Report ipbes:IAS23 ;
    ipbes:hasDescription "Via pan-genomic full genome sequencing which can also track intraspecific genetic variation." ;
    dcterms:identifier "Footnote5.15" .

<http://ontology.ipbes.net/report/fn/IAS23-Footnote5.16> a ipbes:Footnote ;
    ipbes:Report ipbes:IAS23 ;
    ipbes:hasDescription "Only exceptions are burrowing species like beetle grubs or rabbits." ;
    dcterms:identifier "Footnote5.16" .

<http://ontology.ipbes.net/report/fn/IAS23-Footnote5.17> a ipbes:Footnote ;
    ipbes:Report ipbes:IAS23 ;
    ipbes:hasDescription "Only shows effectiveness for fungal pathogens in agriculture using fungicides no demonstrated effectiveness in native ecosystems invaded by invasive alien pathogens." ;
    dcterms:identifier "Footnote5.17" .

<http://ontology.ipbes.net/report/fn/IAS23-Footnote5.18> a ipbes:Footnote ;
    ipbes:Report ipbes:IAS23 ;
    ipbes:hasDescription "Rarely effective (Scott, 1995)." ;
    dcterms:identifier "Footnote5.18" .

<http://ontology.ipbes.net/report/fn/IAS23-Footnote5.19> a ipbes:Footnote ;
    ipbes:Report ipbes:IAS23 ;
    ipbes:hasDescription "Genetic-control approaches for disease resistant commercial plants and animals is widely used in agriculture but this is not discussed in section 5.4.4.2" ;
    dcterms:identifier "Footnote5.19" .

