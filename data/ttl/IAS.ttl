<http://ontology.ipbes.net/report/ref/2352922/items/75T56DRP> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/IAS23ch1>,
        <http://ontology.ipbes.net/report/ch/IAS23ch2>,
        <http://ontology.ipbes.net/report/ch/IAS23ch5> ;
    ipbes:Report ipbes:IAS23 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-1.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-1.6.8>,
