        <http://ontology.ipbes.net/report/key/IAS23-KM-B3> ;
    ipbes:Reference <http://ontology.ipbes.net/report/ref/2352922/items/34NITA66>,
        <http://ontology.ipbes.net/report/ref/2352922/items/68LXSRKX>,
        <http://ontology.ipbes.net/report/ref/2352922/items/698GF6AW>,
        <http://ontology.ipbes.net/report/ref/2352922/items/A8GVBXWK>,
        <http://ontology.ipbes.net/report/ref/2352922/items/AJ4TSBYL>,
        <http://ontology.ipbes.net/report/ref/2352922/items/AXI4B7YE>,
