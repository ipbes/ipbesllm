<http://ontology.ipbes.net/report/sch/IAS23-2.4.2> a ipbes:SubChapter ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/IAS23ch2> ;
    ipbes:Reference <http://ontology.ipbes.net/report/ref/2352922/items/ERERLZTN> ;
    ipbes:Report ipbes:IAS23 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.4> ;
    ipbes:hasDescription "This section reports on the trends and status of established alien species of Africa for animals (section 2.4.2.1), plants (section 2.4.2.2), microorganisms (section 2.4.2.3), and islands (section 2.4.2.4), and provides an overview of data and knowledge gaps (section 2.4.2.5). A description of IPBES regions and sub-regions including a spatial representation is provided online (IPBES Technical Support Unit On Knowledge And Data, 2021) and in Chapter 1, section 1.6.4." ;
    dcterms:identifier "2.4.2" ;
    skos:prefLabel "Trends and status of alien and invasive alien species in Africa" .

<http://ontology.ipbes.net/report/sch/IAS23-2.4.3> a ipbes:SubChapter ;
