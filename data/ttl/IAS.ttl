<http://ontology.ipbes.net/report/ref/2352922/items/XMNL6YLF> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/IAS23ch2>,
        <http://ontology.ipbes.net/report/ch/IAS23ch3>,
        <http://ontology.ipbes.net/report/ch/IAS23ch6> ;
    ipbes:Report ipbes:IAS23 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/IAS23-2.1.1>,
        <http://ontology.ipbes.net/report/sch/IAS23-2.7>,
        <http://ontology.ipbes.net/report/sch/IAS23-3.6>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.3.3>,
        <http://ontology.ipbes.net/report/sch/IAS23-6.3.3.1>,
