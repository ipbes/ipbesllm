        <http://ontology.ipbes.net/report/ref/4589462/items/W9QSMWTV>,
        <http://ontology.ipbes.net/report/ref/4589462/items/WER4BGBN>,
        <http://ontology.ipbes.net/report/ref/4589462/items/WU8EJH3R>,
        <http://ontology.ipbes.net/report/ref/4589462/items/WXLIFXPZ>,
        <http://ontology.ipbes.net/report/ref/4589462/items/XDRMFXHL>,
        <http://ontology.ipbes.net/report/ref/4589462/items/Z6EWL2U3>,
