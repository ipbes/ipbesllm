    ipbes:hasDescription "Imagination gap. Addressing the imagination gap in envisioning positive futures where humans are seen as an integrated part of nature and living in harmony with nature" ;
    ipbes:traceability "Box 2.1, Figure 2.2" ;
    dcterms:identifier "TCA24-15" .

