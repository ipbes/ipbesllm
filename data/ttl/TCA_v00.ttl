        <http://ontology.ipbes.net/report/ref/4589462/items/BUX5YRBG>,
        <http://ontology.ipbes.net/report/ref/4589462/items/CQQXVTKW>,
        <http://ontology.ipbes.net/report/ref/4589462/items/CSC7U39D>,
        <http://ontology.ipbes.net/report/ref/4589462/items/CUELBCSC>,
        <http://ontology.ipbes.net/report/ref/4589462/items/D8QKHETG>,
        <http://ontology.ipbes.net/report/ref/4589462/items/DZU5UYJ8>,
        <http://ontology.ipbes.net/report/ref/4589462/items/H3LTX9VD>,
        <http://ontology.ipbes.net/report/ref/4589462/items/HGFM9IES>,
        <http://ontology.ipbes.net/report/ref/4589462/items/HKD93RK2>,
        <http://ontology.ipbes.net/report/ref/4589462/items/J3THNBH8>,
