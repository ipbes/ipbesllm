    dcterms:identifier "1.2.1, 1.2.2, box 3.3, 4.2.1, 4.2.2" .

<http://ontology.ipbes.net/report/subm/TCA24-A4-SM8> a ipbes:SubMessage ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/TCA24-4.2.1> ;
    ipbes:hasConfidenceLevel "well established" ;
