        <http://ontology.ipbes.net/report/key/TCA24-KM9> ;
    ipbes:Reference <http://ontology.ipbes.net/report/ref/4589462/items/4E6X7KNH>,
        <http://ontology.ipbes.net/report/ref/4589462/items/4I9AG9EQ>,
