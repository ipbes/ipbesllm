        <http://ontology.ipbes.net/report/ref/4589462/items/D567LY5M>,
        <http://ontology.ipbes.net/report/ref/4589462/items/DC3I38YS>,
        <http://ontology.ipbes.net/report/ref/4589462/items/DN7PG6HI>,
        <http://ontology.ipbes.net/report/ref/4589462/items/EMJVEMUF>,
        <http://ontology.ipbes.net/report/ref/4589462/items/FHPGRSKT>,
