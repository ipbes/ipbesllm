<http://ontology.ipbes.net/report/ref/4589462/items/ZWXEXNU6> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/TCA24ch1>,
        <http://ontology.ipbes.net/report/ch/TCA24ch2>,
        <http://ontology.ipbes.net/report/ch/TCA24ch4> ;
    ipbes:Report ipbes:TCA24 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/TCA24-1.2.2>,
