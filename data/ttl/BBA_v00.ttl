        <http://ontology.ipbes.net/report/ref/5081872/items/IXY2YMF6>,
        <http://ontology.ipbes.net/report/ref/5081872/items/JFBTISLS>,
        <http://ontology.ipbes.net/report/ref/5081872/items/KJUPEMI3>,
        <http://ontology.ipbes.net/report/ref/5081872/items/LBBCIV7I>,
        <http://ontology.ipbes.net/report/ref/5081872/items/M55ADRXV>,
        <http://ontology.ipbes.net/report/ref/5081872/items/MEUBGQM7>,
