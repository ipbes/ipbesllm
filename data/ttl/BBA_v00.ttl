        <http://ontology.ipbes.net/report/ref/5081872/items/JVSMFVC7>,
        <http://ontology.ipbes.net/report/ref/5081872/items/KQS7KZZH>,
        <http://ontology.ipbes.net/report/ref/5081872/items/M55ADRXV>,
        <http://ontology.ipbes.net/report/ref/5081872/items/MTWG93VA>,
        <http://ontology.ipbes.net/report/ref/5081872/items/PEF8YUVY>,
        <http://ontology.ipbes.net/report/ref/5081872/items/QUMV3GUQ>,
        <http://ontology.ipbes.net/report/ref/5081872/items/QZCJXAWJ>,
