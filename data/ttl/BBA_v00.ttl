        <http://ontology.ipbes.net/report/key/BBA26-KM6> ;
    ipbes:Reference <http://ontology.ipbes.net/report/ref/5081872/items/28BG4D5W>,
        <http://ontology.ipbes.net/report/ref/5081872/items/3Q6ZYAKY>,
        <http://ontology.ipbes.net/report/ref/5081872/items/6UZ8PQ9V>,
        <http://ontology.ipbes.net/report/ref/5081872/items/6ZMTHYFN>,
        <http://ontology.ipbes.net/report/ref/5081872/items/7KSGXH4M>,
        <http://ontology.ipbes.net/report/ref/5081872/items/96THJ33D>,
        <http://ontology.ipbes.net/report/ref/5081872/items/9ST379IT>,
        <http://ontology.ipbes.net/report/ref/5081872/items/AN2JNDEY>,
        <http://ontology.ipbes.net/report/ref/5081872/items/B4GWAEQA>,
        <http://ontology.ipbes.net/report/ref/5081872/items/D5XZBVW2>,
        <http://ontology.ipbes.net/report/ref/5081872/items/DMCKDIVW>,
        <http://ontology.ipbes.net/report/ref/5081872/items/DPQQC3KT>,
