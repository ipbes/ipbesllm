    ipbes:Reference <http://ontology.ipbes.net/report/ref/5081872/items/FGXJ5GJT>,
        <http://ontology.ipbes.net/report/ref/5081872/items/G2I5QTNU>,
        <http://ontology.ipbes.net/report/ref/5081872/items/KIK4ARGL>,
        <http://ontology.ipbes.net/report/ref/5081872/items/QBWQQNJ9> ;
