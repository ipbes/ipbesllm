<http://ontology.ipbes.net/report/ref/5081872/items/YPP5U9W8> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/BBA26ch1>,
        <http://ontology.ipbes.net/report/ch/BBA26ch2>,
        <http://ontology.ipbes.net/report/ch/BBA26ch4>,
        <http://ontology.ipbes.net/report/ch/BBA26ch5> ;
    ipbes:Report ipbes:BBA26 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/BBA26-1.4.1>,
        <http://ontology.ipbes.net/report/sch/BBA26-1.5.1>,
        <http://ontology.ipbes.net/report/sch/BBA26-1.5.5>,
        <http://ontology.ipbes.net/report/sch/BBA26-2.6.1>,
        <http://ontology.ipbes.net/report/sch/BBA26-4.6>,
        <http://ontology.ipbes.net/report/sch/BBA26-4.6.2>,
        <http://ontology.ipbes.net/report/sch/BBA26-5.3.2> ;
    ipbes:hasDescription "Ingram, J. C., McKenzie, E. J., Bagstad, K. J., Finisdore, J., Van Den Berg, R., Fenichel, E., Vardon, M., Posner, S., Santamaria, M., Mandle, L., Barker, R., & Spurgeon, J. (2024). Leveraging natural capital accounting to support businesses with nature-related risk assessments and disclosures. Philosophical Transactions of the Royal Society B: Biological Sciences, 379(1903), 20220328. https://doi.org/10.1098/rstb.2022.0328" ;
