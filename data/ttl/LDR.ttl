        <http://ontology.ipbes.net/report/ref/2333076/items/VV7JHZ45>,
        <http://ontology.ipbes.net/report/ref/2333076/items/VWJFC266>,
        <http://ontology.ipbes.net/report/ref/2333076/items/XLDGUIW9>,
        <http://ontology.ipbes.net/report/ref/2333076/items/XMCJBXQF>,
        <http://ontology.ipbes.net/report/ref/2333076/items/XV3RKGB2>,
        <http://ontology.ipbes.net/report/ref/2333076/items/XWQWYX9E>,
