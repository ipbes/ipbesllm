    ipbes:Reference <http://ontology.ipbes.net/report/ref/2333076/items/35KUQFGY>,
        <http://ontology.ipbes.net/report/ref/2333076/items/49ZVCWGL>,
        <http://ontology.ipbes.net/report/ref/2333076/items/6D7C6NIS>,
        <http://ontology.ipbes.net/report/ref/2333076/items/7BLTL29Q>,
        <http://ontology.ipbes.net/report/ref/2333076/items/A63S4GFF>,
        <http://ontology.ipbes.net/report/ref/2333076/items/APSW82Q9>,
        <http://ontology.ipbes.net/report/ref/2333076/items/CP4HPSYX>,
        <http://ontology.ipbes.net/report/ref/2333076/items/GXRZ8UU9>,
        <http://ontology.ipbes.net/report/ref/2333076/items/I5JYQD9E>,
