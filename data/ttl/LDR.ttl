        <http://ontology.ipbes.net/report/ref/2333076/items/5B2BLTBW>,
        <http://ontology.ipbes.net/report/ref/2333076/items/5K6ZK76U>,
        <http://ontology.ipbes.net/report/ref/2333076/items/5VIP7JZW>,
        <http://ontology.ipbes.net/report/ref/2333076/items/BEXBND2J>,
        <http://ontology.ipbes.net/report/ref/2333076/items/DYZDDWV5>,
        <http://ontology.ipbes.net/report/ref/2333076/items/FN2TYVI3>,
        <http://ontology.ipbes.net/report/ref/2333076/items/GEJZNRU8>,
        <http://ontology.ipbes.net/report/ref/2333076/items/GNAWV7KP>,
        <http://ontology.ipbes.net/report/ref/2333076/items/J3FECPRY>,
        <http://ontology.ipbes.net/report/ref/2333076/items/JGZHRTHZ>,
