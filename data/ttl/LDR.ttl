<http://ontology.ipbes.net/report/ref/2333076/items/8V6SIRRX> a ipbes:Reference ;
    ipbes:Chapter <http://ontology.ipbes.net/report/ch/LDR18ch5>,
        <http://ontology.ipbes.net/report/ch/LDR18ch7> ;
    ipbes:Report ipbes:LDR18 ;
    ipbes:SubChapter <http://ontology.ipbes.net/report/sch/LDR18-5.3.1.1>,
        <http://ontology.ipbes.net/report/sch/LDR18-5.3.2.1>,
        <http://ontology.ipbes.net/report/sch/LDR18-5.3.2.4>,
        <http://ontology.ipbes.net/report/sch/LDR18-5.3.3.2>,
        <http://ontology.ipbes.net/report/sch/LDR18-7.2>,
