    ipbes:Reference <http://ontology.ipbes.net/report/ref/2333076/items/3JCSR5D2>,
        <http://ontology.ipbes.net/report/ref/2333076/items/7GAYKVDL>,
        <http://ontology.ipbes.net/report/ref/2333076/items/EDE62VND>,
        <http://ontology.ipbes.net/report/ref/2333076/items/EYDL6EVM>,
        <http://ontology.ipbes.net/report/ref/2333076/items/JZJ5F2GB>,
        <http://ontology.ipbes.net/report/ref/2333076/items/MA2DEQH3>,
        <http://ontology.ipbes.net/report/ref/2333076/items/MVSHSLU6>,
        <http://ontology.ipbes.net/report/ref/2333076/items/Q556N4ZQ>,
        <http://ontology.ipbes.net/report/ref/2333076/items/R6WICSX7>,
        <http://ontology.ipbes.net/report/ref/2333076/items/RGTS6HAF>,
        <http://ontology.ipbes.net/report/ref/2333076/items/SMNQ4FVP>,
        <http://ontology.ipbes.net/report/ref/2333076/items/TREUPF82>,
