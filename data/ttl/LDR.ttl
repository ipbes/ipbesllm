        <http://ontology.ipbes.net/report/ref/2333076/items/7ZZ8APAX>,
        <http://ontology.ipbes.net/report/ref/2333076/items/C2DNERI5>,
        <http://ontology.ipbes.net/report/ref/2333076/items/C7CQPTFH>,
        <http://ontology.ipbes.net/report/ref/2333076/items/EEVL8HBS>,
        <http://ontology.ipbes.net/report/ref/2333076/items/G48Y2HRD>,
        <http://ontology.ipbes.net/report/ref/2333076/items/GFP754E9>,
        <http://ontology.ipbes.net/report/ref/2333076/items/GGSV2HHR>,
        <http://ontology.ipbes.net/report/ref/2333076/items/J35F5NL9>,
        <http://ontology.ipbes.net/report/ref/2333076/items/M87L8ZXL>,
        <http://ontology.ipbes.net/report/ref/2333076/items/MVAN6NBU>,
        <http://ontology.ipbes.net/report/ref/2333076/items/PD69QT4K>,
        <http://ontology.ipbes.net/report/ref/2333076/items/QHY2L9JU>,
        <http://ontology.ipbes.net/report/ref/2333076/items/RIEDBIKA>,
        <http://ontology.ipbes.net/report/ref/2333076/items/TCLBVBN4>,
        <http://ontology.ipbes.net/report/ref/2333076/items/U378ES2P>,
        <http://ontology.ipbes.net/report/ref/2333076/items/UBT3KWQT>,
        <http://ontology.ipbes.net/report/ref/2333076/items/VLJNFZ6X>,
        <http://ontology.ipbes.net/report/ref/2333076/items/XJR6DGJ2>,
        <http://ontology.ipbes.net/report/ref/2333076/items/Z9PU8UNX>,
